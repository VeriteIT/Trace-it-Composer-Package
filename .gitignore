# Secrets — never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/
# Composer deps for the PHP demo layer. composer.json/lock ARE committed so the
# tree is reproducible; the installed packages are not.
vendor/
# Locally installed composer.phar
.tools/

# Build/generated output
verify-output/

# Runtime state: the articleId -> QR store and the mock CMS's articles.
# Regenerated on demand; the QR data URIs make it large and noisy in diffs.
data/

# Logs
*.log
npm-debug.log*

# OS / editor
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
