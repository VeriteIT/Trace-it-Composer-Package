# Copy to .env and fill in. Never commit .env.
#
# NOTE: nothing in this project loads .env automatically (no dotenv dependency).
# Either export these in your shell before `npm start`, or add dotenv yourself.
#
#   PowerShell:  $env:TRACEIT_API_KEY="sk_live_..."
#   bash:        export TRACEIT_API_KEY="sk_live_..."

# --- Trace-It API -----------------------------------------------------------
#
#   >>> NEVER PUT A REAL KEY IN THIS FILE. <<<
#
# .env.example is TRACKED BY GIT (see the !.env.example rule in .gitignore) —
# it is the committed template. A key written here goes into git history on the
# next commit and to GitHub on the next push. Put real values in .env, which is
# gitignored, or export them in your shell.
#
# Leave TRACEIT_API_KEY empty to generate real, scannable QR codes locally.
# Those are NOT tracked links, but every other part of the flow is identical.
TRACEIT_API_KEY=
TRACEIT_BASE=https://demo.trace-it.io
TRACEIT_FOLDER=Newsroom thumbnails

# --- Our service ------------------------------------------------------------
# Shared secret the publisher's CMS uses to call our publish webhook.
TRACEIT_WEBHOOK_SECRET=dev-webhook-secret

# Origins allowed to call our service from a browser (the publisher's domains).
TRACEIT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set false once the publish webhook is live. The public endpoint can then only
# SERVE codes, never create them, which removes all quota exposure.
ALLOW_LAZY_MINT=true

# Where a QR scan should land. {id} is replaced with the article ID.
ARTICLE_URL_TEMPLATE=http://localhost:3000/article/{id}

# Hosts a minted QR is allowed to point at. Defaults to the host in
# ARTICLE_URL_TEMPLATE. Stops a leaked webhook secret from being used to mint
# tracked links to arbitrary destinations under the client's account.
TRACEIT_ALLOWED_DESTINATION_HOSTS=localhost:3000

# --- Embed mode (QR baked into the pixels, so Save-as includes it) -----------
# Hosts we will fetch a source image from. THIS IS A SECURITY CONTROL: embed
# mode fetches images server-side from a URL that can arrive in a query
# parameter, so without an allowlist it is an SSRF hole (cloud metadata
# endpoints, localhost admin panels, anything on the internal network).
# Set this to the publisher's real S3/CDN hostnames before deploying.
TRACEIT_ALLOWED_IMAGE_HOSTS=localhost:3001,127.0.0.1:3001

# JPEG quality for the re-encode. 95 measured best across source qualities;
# 98 buys nothing measurable and inflates the file.
TRACEIT_JPEG_QUALITY=95

# --- Ports ------------------------------------------------------------------
PORT=3000          # publisher site (theirs)
S3_PORT=3001       # simulated S3 image origin (theirs)
TRACEIT_PORT=3002  # our Trace-It service
